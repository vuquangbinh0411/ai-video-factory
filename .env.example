# ==============================================================================
# AI Video Factory - Biến môi trường cấu hình (Environment Variables)
# ==============================================================================

# --- Google Gemini API (Khuyến nghị 0 đồng, không tốn thẻ tín dụng) ---
# Lấy API Key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
CUSTOM_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
CUSTOM_LLM_API_KEY=your_gemini_api_key_here
CUSTOM_LLM_MODEL_NAME=gemini-1.5-flash

# --- Image Generation (FLUX 9:16 Vertical) ---
# Engine hỗ trợ: 'pollinations' (Miễn phí, không cần key) hoặc 'fal' (Fal.ai FLUX Schnell/Dev)
DEFAULT_IMAGE_ENGINE=pollinations
FAL_KEY=your_fal_ai_key_optional

# --- Text-to-Speech (Edge-TTS Tiếng Việt) ---
# Lựa chọn: vi-VN-HoaiMyNeural (Nữ) hoặc vi-VN-NamMinhNeural (Nam)
DEFAULT_TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# --- Music Generation (ACE-Step 1.5 / Lo-Fi Engine) ---
ACE_STEP_API_URL=https://api.example.com/ace-step-1.5
ACE_STEP_API_KEY=your_music_api_key_optional
MUSIC_VOLUME=0.15

# --- Facebook Graph API (Tự động đăng Reels) ---
FB_PAGE_ID=your_facebook_page_id
FB_ACCESS_TOKEN=your_long_lived_facebook_access_token

# --- Đường dẫn lưu trữ (Shared Volume) ---
SHARED_MEDIA_DIR=shared_media
TEMP_DIR=shared_media/temp
OUTPUT_DIR=shared_media/outputs

# --- Cấu hình n8n Container ---
N8N_PORT=5678
N8N_TIMEZONE=Asia/Ho_Chi_Minh
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
